{
  "name": "@text-picker/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "nodemon --watch src --exec \"tsup\"",
    "turbo:build": "pnpm build",
    "turbo:dev": "pnpm dev",
    "turbo:ui": "pnpm dev"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*/index.js"
    }
  },
  "devDependencies": {
    "chrome-types": "latest",
    "nodemon": "^3.1.9",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}