{
  "name": "v1",
  "version": "0.0.0",
  "description": "An app that makes it easy to extract the text you need from web pages.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build -c vite/config/background.ts && vite build -c vite/config/bridge.ts && vite build -c vite/config/tab.ts",
    "preview": "vite preview",
    "ui": "storybook dev -p 6006",
    "ui.build": "storybook build",
    "turbo:build": "pnpm build",
    "turbo:dev": "pnpm build",
    "turbo:ui": "pnpm ui"
  },
  "dependencies": {
    "@text-picker/core": "workspace:*",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/node": "20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
